{
  "name": "@rathnasgala2/adapter-conformance-kit",
  "version": "0.1.0",
  "description": "Reusable node:test conformance suite every @rathnasgala2 deployment adapter must pass: lifecycle shape, capability truthfulness, staging privacy, activation atomicity, observe/verify, cleanup, rollback, idempotent re-run, crash injection and tamper detection.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "files": [
    "src/",
    "types/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "declarations:generate": "tsc -p tsconfig.declarations.json",
    "declarations:check": "node ../../scripts/check-declarations.mjs adapter-conformance-kit"
  },
  "dependencies": {
    "@rathnasgala2/adapter-protocol": "0.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
