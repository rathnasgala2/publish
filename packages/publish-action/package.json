{
  "name": "@rathnasgala2/publish-action",
  "version": "0.1.0",
  "description": "Author-facing publish orchestration entry: GitHub Action plus local npx validate/build/preview.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "bin": {
    "publish-action": "./src/bin/cli.js"
  },
  "files": [
    "src/",
    "types/",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "declarations:generate": "tsc -p tsconfig.declarations.json",
    "declarations:check": "node ../../scripts/check-declarations.mjs publish-action"
  },
  "dependencies": {
    "@rathnasgala2/adapter-local-directory": "^0.1.0",
    "@rathnasgala2/adapter-protocol": "^0.2.0",
    "@rathnasgala2/publish-kernel": "^0.1.0",
    "@rathnasgala2/schemas": "2.11.0",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@rathnasgala2/template": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@rathnasgala2/template": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rathnasgala2/publish.git",
    "directory": "packages/publish-action"
  },
  "homepage": "https://github.com/rathnasgala2/publish/tree/main/packages/publish-action#readme",
  "bugs": {
    "url": "https://github.com/rathnasgala2/publish/issues"
  },
  "keywords": [
    "gala",
    "galascribe",
    "publish",
    "github-action",
    "cli"
  ]
}
