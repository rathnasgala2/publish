{
  "name": "@rathnasgala2/adapter-do-spaces",
  "version": "0.1.0",
  "description": "Managed DigitalOcean Spaces deployment adapter: two-bucket website binding, exact SigV4 request catalog, private generation-prefixed staging, replace-in-place activation with a marker-last pointer write, and credential-free public verification.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "files": [
    "src/",
    "types/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "declarations:generate": "tsc -p tsconfig.declarations.json",
    "declarations:check": "node ../../scripts/check-declarations.mjs adapter-do-spaces"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@rathnasgala2/adapter-protocol": "0.2.0",
    "@rathnasgala2/schemas": "2.11.0"
  },
  "devDependencies": {
    "@rathnasgala2/adapter-conformance-kit": "0.1.0"
  }
}
