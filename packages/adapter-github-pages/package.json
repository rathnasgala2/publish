{
  "name": "@rathnasgala2/adapter-github-pages",
  "version": "0.1.0",
  "description": "Managed GitHub Pages deployment adapter: deterministic gzip/ustar Pages carrier, raw Pages deployment REST catalog, bounded status polling and credential-free public verification.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "files": [
    "src/",
    "types/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "declarations:generate": "tsc -p tsconfig.declarations.json",
    "declarations:check": "node ../../scripts/check-declarations.mjs adapter-github-pages"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@rathnasgala2/adapter-protocol": "^0.2.0",
    "@rathnasgala2/schemas": "2.11.0"
  },
  "devDependencies": {
    "@rathnasgala2/adapter-conformance-kit": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rathnasgala2/publish.git",
    "directory": "packages/adapter-github-pages"
  },
  "homepage": "https://github.com/rathnasgala2/publish/tree/main/packages/adapter-github-pages#readme",
  "bugs": {
    "url": "https://github.com/rathnasgala2/publish/issues"
  },
  "keywords": [
    "gala",
    "galascribe",
    "publish",
    "adapter",
    "github-pages"
  ]
}
