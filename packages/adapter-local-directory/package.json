{
  "name": "@rathnasgala2/adapter-local-directory",
  "version": "0.1.0",
  "description": "Reference POSIX local-directory deployment adapter and gala-local-directory-filesystem-v2 conformance oracle.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "files": [
    "src/",
    "types/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "declarations:generate": "tsc -p tsconfig.declarations.json",
    "declarations:check": "node ../../scripts/check-declarations.mjs adapter-local-directory"
  },
  "dependencies": {
    "@rathnasgala2/adapter-protocol": "0.2.0",
    "@rathnasgala2/schemas": "2.11.0"
  },
  "devDependencies": {
    "@rathnasgala2/adapter-conformance-kit": "0.1.0",
    "@rathnasgala2/publish-kernel": "0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
