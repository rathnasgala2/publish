{
  "name": "@rathnasgala2/publish-kernel",
  "version": "0.1.1",
  "description": "Provider-neutral, non-disableable publish safety kernel: the ten kernel duties over explicit inputs (DEC-016).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "files": [
    "src/",
    "types/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "declarations:generate": "tsc -p tsconfig.declarations.json",
    "declarations:check": "node ../../scripts/check-declarations.mjs publish-kernel"
  },
  "dependencies": {
    "@rathnasgala2/adapter-protocol": "^0.2.1",
    "@rathnasgala2/schemas": "2.11.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rathnasgala2/publish.git",
    "directory": "packages/publish-kernel"
  },
  "homepage": "https://github.com/rathnasgala2/publish/tree/main/packages/publish-kernel#readme",
  "bugs": {
    "url": "https://github.com/rathnasgala2/publish/issues"
  },
  "keywords": [
    "gala",
    "galascribe",
    "publish",
    "kernel",
    "supply-chain-security"
  ]
}
